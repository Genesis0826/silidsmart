# Sandbox integration only. The application does not load this file automatically.
# Set these in the backend process environment when test access exists.
# Never put a live key here or commit a populated local environment file.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_BILLING_SANDBOX=false
SILIDSMART_APP_ORIGIN=http://127.0.0.1:5173
# Require a sk_test_ key, webhook secret and explicit enablement together.
# Register POST /api/payments/paymongo/webhook on a reachable HTTPS test backend.
# Only sandbox checkout is supported. Test payments never settle real bills.
# Live rent, owner routing, commission deductions and payouts remain disabled.
# See docs/TENANT_BILLING.md and docs/PAYMENT_PILOT.md.
